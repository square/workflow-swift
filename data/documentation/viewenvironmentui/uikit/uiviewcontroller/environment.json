{"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"symbol","primaryContentSections":[{"declarations":[{"tokens":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"environment","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:15ViewEnvironmentAAV","text":"ViewEnvironment","kind":"typeIdentifier"},{"text":" { ","kind":"text"},{"text":"get","kind":"keyword"},{"text":" }","kind":"text"}],"platforms":["iOS"],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"type":"text","text":"If you’d like to provide overrides for the environment as it flows through a node, you should conform to"},{"type":"text","text":" "},{"code":"ViewEnvironmentObserving","type":"codeVoice"},{"type":"text","text":" and provide those overrides in "},{"code":"customize(environment:)","type":"codeVoice"},{"type":"text","text":". E.g.:"}],"type":"paragraph"},{"code":["func customize(environment: inout ViewEnvironment) {","    environment.traits.mode = .dark","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"By default, this property gets the environment by recursively walking to the root of the"},{"type":"text","text":" "},{"type":"text","text":"propagation path, and applying customizations on the way back down. The invalidation path may be"},{"type":"text","text":" "},{"type":"text","text":"interrupted if a node has set it’s "},{"code":"environmentAncestor","type":"codeVoice"},{"type":"text","text":" to "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", even if there is a node"},{"type":"text","text":" "},{"type":"text","text":"which specifies this node as an "},{"code":"environmentDescendant","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"If you’d like to update the return value of this variable and have those changes propagated through the","type":"text"},{"text":" ","type":"text"},{"text":"propagation hierarchy, conform to ","type":"text"},{"code":"ViewEnvironmentObserving","type":"codeVoice"},{"text":" and call ","type":"text"},{"type":"codeVoice","code":"setNeedsEnvironmentUpdate()"},{"type":"text","text":" and wait"},{"type":"text","text":" "},{"text":"for the system to call ","type":"text"},{"type":"codeVoice","code":"apply(context:)"},{"text":" when appropriate (e.g. on the next layout pass for","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UIViewController"},{"text":"\/","type":"text"},{"type":"codeVoice","code":"UIView"},{"text":" subclasses).","type":"text"}],"type":"paragraph"},{"name":"Important","type":"aside","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"code":"UIViewController","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"UIView","type":"codeVoice"},{"text":" conformers ","type":"text"},{"inlineContent":[{"text":"must","type":"text"}],"type":"emphasis"},{"text":" call ","type":"text"},{"code":"applyEnvironmentIfNeeded()","type":"codeVoice"},{"text":" in","type":"text"},{"text":" ","type":"text"},{"code":"viewWillLayoutSubviews()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"layoutSubviews()","type":"codeVoice"},{"text":" respectively.","type":"text"}]}]}]}],"abstract":[{"type":"text","text":"The "},{"type":"codeVoice","code":"ViewEnvironment"},{"type":"text","text":" that is flowing through the propagation hierarchy."}],"variants":[{"paths":["\/documentation\/viewenvironmentui\/uikit\/uiviewcontroller\/environment"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/ViewEnvironmentUI\/documentation\/ViewEnvironmentUI\/UIKit\/UIViewController\/environment"},"metadata":{"roleHeading":"Instance Property","extendedModule":"ViewEnvironmentUI","symbolKind":"property","modules":[{"name":"ViewEnvironmentUI"}],"role":"symbol","title":"environment","fra