{"topicSections":[{"identifiers":["doc:\/\/Workflow\/documentation\/Workflow\/RenderContext\/makeOutputSink()","doc:\/\/Workflow\/documentation\/Workflow\/RenderContext\/makeSink(of:)","doc:\/\/Workflow\/documentation\/Workflow\/RenderContext\/makeSink(of:onEvent:)","doc:\/\/Workflow\/documentation\/Workflow\/RenderContext\/makeStateMutationSink()","doc:\/\/Workflow\/documentation\/Workflow\/RenderContext\/runSideEffect(key:action:)"],"anchor":"Instance-Methods","generated":true,"title":"Instance Methods"}],"identifier":{"url":"doc:\/\/Workflow\/documentation\/Workflow\/RenderContext","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/Workflow\/documentation\/Workflow"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["iOS"],"tokens":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RenderContext","kind":"identifier"},{"text":"<","kind":"text"},{"text":"WorkflowType","kind":"genericParameter"},{"text":"> ","kind":"text"},{"text":"where","kind":"keyword"},{"text":" ","kind":"text"},{"text":"WorkflowType","kind":"typeIdentifier"},{"text":" : ","kind":"text"},{"identifier":"doc:\/\/Workflow\/documentation\/Workflow\/Workflow","text":"Workflow","preciseIdentifier":"s:8WorkflowAAP","kind":"typeIdentifier"}],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"During a render pass, a workflow may want to defer to a child"},{"type":"text","text":" "},{"type":"text","text":"workflow to render some portion of its content. For example,"},{"type":"text","text":" "},{"type":"text","text":"a workflow that renders to a split-screen view model might"},{"type":"text","text":" "},{"type":"text","text":"delegate to child A for the left side, and child B for the right"},{"type":"text","text":" "},{"type":"text","text":"side view models. Nesting allows for a fractal tree that is constructed"},{"type":"text","text":" "},{"type":"text","text":"out of many small parts."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a parent wants to delegate to a child workflow, it must first"},{"type":"text","text":" "},{"type":"text","text":"create an instance of that workflow. This can be thought of as the"},{"type":"text","text":" "},{"type":"text","text":"model of the child workflow. It does not contain any active state,"},{"type":"text","text":" "},{"type":"text","text":"it simply contains the data necessary to create or update a workflow"},{"type":"text","text":" "},{"type":"text","text":"node."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent then calls "},{"type":"codeVoice","code":"render(workflow:outputMap:)"},{"type":"text","text":" "},{"type":"text","text":"with two values:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The child workflow."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A closure that transforms the child’s output events into the parent’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"Event"},{"type":"text","text":" type so that the parent can respond to events generated by"},{"type":"text","text":" "},{"type":"text","text":"the child."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the parent had previously rendered a child of the same type, the existing"},{"type":"text","text":" "},{"type":"text","text":"child workflow node is updated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the parent had not rendered a child of the same type in the previous"},{"type":"text","text":" "},{"type":"text","text":"render pass, a new child workflow node is generated."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The infrastructure then performs a render pass on the child to obtain its"},{"type":"text","text":" "},{"type":"codeVoice","code":"Rendering"},{"tex