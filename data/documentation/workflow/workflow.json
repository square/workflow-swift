l state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"If the parent had previously rendered a child of this type, the"},{"type":"text","text":" "},{"type":"text","text":"existing workflow node will be updated."},{"type":"text","text":" "},{"type":"codeVoice","code":"workflowDidChange(from:state:)"},{"type":"text","text":" will be invoked"},{"type":"text","text":" "},{"type":"text","text":"to allow the workflow to respond to the change."}],"type":"paragraph"}]}]},{"type":"thematicBreak"},{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Render","type":"text"}]}]},{"type":"thematicBreak"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After a workflow node has been created, or any time its state changes,"},{"type":"text","text":" "},{"type":"text","text":"a render pass occurs. The render pass takes the workflow that was passed"},{"type":"text","text":" "},{"type":"text","text":"down from the parent along with the current state and generates a value"},{"type":"text","text":" "},{"type":"text","text":"of type "},{"type":"codeVoice","code":"Rendering"},{"type":"text","text":". In a common case, a workflow might render to a screen"},{"type":"text","text":" "},{"type":"text","text":"model for display."}]},{"syntax":null,"type":"codeListing","code":["func render(state: State, context: RenderContext<Self>) -> MyScreenModel {","    return MyScreenModel()","}"]}],"kind":"content"}],"metadata":{"externalID":"s:8WorkflowAAP","symbolKind":"protocol","modules":[{"name":"Workflow"}],"role":"symbol","roleHeading":"Protocol","title":"Workflow","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Workflow","kind":"identifier"}],"navigatorTitle":[{"kind":"identifier","text":"Workflow"}]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/Workflow\/documentation\/Workflow\/Workflow"},"topicSections":[{"anchor":"Associated-Types","generated":true,"identifiers":