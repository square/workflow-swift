er ","type":"text"},{"code":"wrappedScreen","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"references":{"doc://WorkflowUI/documentation/WorkflowUI/SingleScreenContaining":{"navigatorTitle":[{"text":"SingleScreenContaining","kind":"identifier"}],"url":"\/documentation\/workflowui\/singlescreencontaining","title":"SingleScreenContaining","abstract":[{"text":"Defines a type that semantically ‘contains’ a ","type":"text"},{"code":"Screen","type":"codeVoice"},{"text":" instance.","type":"text"}],"identifier":"doc:\/\/WorkflowUI\/documentation\/WorkflowUI\/SingleScreenContaining","type":"topic","role":"symbol","fragments":[{"text":"protocol","kind":"keyword"},{"text":" ","kind":"text"},{"text":"SingleScreenContaining","kind":"identifier"}],"kind":"symbol"},"doc://WorkflowUI/documentation/WorkflowUI/ScreenViewController":{"navigatorTitle":[{"text":"ScreenViewController","kind":"identifier"}],"abstract":[{"text":"Generic base class that can be subclassed in order to to define a UI implementation that is powered by the","type":"text"},{"text":" ","type":"text"},{"text":"given screen type.","type":"text"}],"title":"ScreenViewController","url":"\/documentation\/workflowui\/screenviewcontroller","identifier":"doc:\/\/WorkflowUI\/documentation\/WorkflowUI\/ScreenViewController","conformance":{"availabilityPrefix":[{"text":"Available when","type":"text"}],"constraints":[{"code":"ScreenType","type":"codeVoice"},{"text":" conforms to ","type":"text"},{"code":"Screen","type":"codeVoice"},{"text":".","type":"text"}],"conformancePrefix":[{"text":"Conforms when","type":"text"}]},"type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"class"},{"text":" ","kind":"text"},{"text":"ScreenViewController","kind":"identifier"}],"kind":"symbol"},"doc://WorkflowUI/documentation/WorkflowUI/SingleScreenContaining/findInnermostPrimaryScreen()":{"url":"\/documentation\/workflowui\/singlescreencontaining\/findinnermostprimaryscreen()","title":"findInnermostPrima